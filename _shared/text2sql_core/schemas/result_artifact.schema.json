{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/text2sql/result_artifact.schema.json",
  "title": "Text2SQL ResultArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "artifact_id",
    "artifact_sha256",
    "created_at",
    "trace_id",
    "domain",
    "plan_id",
    "sql_sha256",
    "policy_report_sha256",
    "query_id",
    "status",
    "ok",
    "engine",
    "editor",
    "submission",
    "timing",
    "result",
    "download",
    "validation"
  ],
  "properties": {
    "artifact_type": {"const": "result_artifact"},
    "schema_version": {"const": "1.1.0"},
    "artifact_id": {"type": "string", "pattern": "^result_[0-9a-f]{32}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "trace_id": {"type": "string", "pattern": "^trace_[0-9a-f]{32}$"},
    "domain": {"enum": ["market_consultant", "qingcheng", "unresolved"]},
    "plan_id": {"type": ["string", "null"]},
    "sql_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "query_id": {"type": ["string", "null"]},
    "status": {"type": "string"},
    "ok": {"type": "boolean"},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "selected_key", "selected_label", "history_value"],
      "properties": {
        "requested": {"type": ["string", "null"]},
        "selected_key": {"type": ["string", "null"]},
        "selected_label": {"type": ["string", "null"]},
        "history_value": {"type": ["string", "null"]}
      }
    },
    "editor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["sql_sha256", "byte_length", "stable_reads"],
      "properties": {
        "sql_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "byte_length": {"type": ["integer", "null"], "minimum": 0},
        "stable_reads": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "submission": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "query_id_source",
        "mechanism",
        "attempt_count",
        "request_path",
        "http_status",
        "submitted_sql_sha256",
        "submitted_engine"
      ],
      "properties": {
        "query_id_source": {"type": ["string", "null"]},
        "mechanism": {"type": ["string", "null"]},
        "attempt_count": {"type": ["integer", "null"], "minimum": 1},
        "request_path": {"type": ["string", "null"]},
        "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "submitted_sql_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "submitted_engine": {"type": ["string", "null"]}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_duration_seconds", "elapsed_seconds"],
      "properties": {
        "query_duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "elapsed_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "source",
        "headers",
        "row_count_visible",
        "no_more",
        "preview_sha256",
        "preview_rows_redacted",
        "api_http_status",
        "api_error_code",
        "api_meta_count",
        "api_row_count_page",
        "api_total_rows",
        "completion_source",
        "evidence_conflict",
        "ui_state"
      ],
      "properties": {
        "state": {
          "enum": [
            "success_with_rows",
            "success_ui_missing_recovered",
            "success_empty_verified",
            "success_with_rows_ui",
            "result_unresolved",
            null
          ]
        },
        "source": {"enum": ["result_api", "result_api_and_ui", "ui", null]},
        "headers": {"type": "array", "items": {"type": "string"}},
        "row_count_visible": {"type": ["integer", "null"], "minimum": 0},
        "no_more": {"type": ["boolean", "null"]},
        "preview_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "preview_rows_redacted": {"const": true},
        "api_http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "api_error_code": {"type": ["integer", "string", "null"]},
        "api_meta_count": {"type": ["integer", "null"], "minimum": 0},
        "api_row_count_page": {"type": ["integer", "null"], "minimum": 0},
        "api_total_rows": {"type": ["integer", "null"], "minimum": 0},
        "completion_source": {
          "enum": ["result_api", "log_api", "history", "ui_result", "ui_error", "legacy_ui", null]
        },
        "evidence_conflict": {
          "enum": ["api_zero_ui_rows", "api_failure_ui_rows", null]
        },
        "ui_state": {
          "enum": ["ui_with_rows", "ui_panel_visible", "ui_empty_stable", "ui_timeout", null]
        }
      }
    },
    "download": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "expected_columns", "diagnostics"],
      "properties": {
        "status": {"enum": ["passed", "warning", "failed"]},
        "expected_columns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "severity", "message"],
            "properties": {
              "code": {"type": "string"},
              "severity": {"enum": ["warning", "error"]},
              "message": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
