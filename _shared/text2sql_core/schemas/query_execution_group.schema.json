{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/text2sql/query_execution_group.schema.json",
  "title": "Text2SQL QueryExecutionGroupArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "group_id",
    "artifact_sha256",
    "created_at",
    "domain",
    "plan_id",
    "sql_sha256",
    "fallback_policy",
    "attempts",
    "final"
  ],
  "properties": {
    "artifact_type": {"const": "query_execution_group"},
    "schema_version": {"const": "1.0.0"},
    "group_id": {"type": "string", "pattern": "^query_group_[0-9a-f]{32}$"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "domain": {"enum": ["market_consultant", "qingcheng", "unresolved"]},
    "plan_id": {"type": ["string", "null"]},
    "sql_sha256": {"$ref": "#/$defs/sha256"},
    "fallback_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "primary_engine",
        "fallback_engine",
        "max_attempts",
        "eligible_triggers",
        "empty_result_policy",
        "resolution_source",
        "equivalence_group",
        "registry_sha256"
      ],
      "properties": {
        "mode": {"const": "fallback_once"},
        "primary_engine": {"$ref": "#/$defs/engine"},
        "fallback_engine": {"$ref": "#/$defs/engine"},
        "max_attempts": {"const": 2},
        "eligible_triggers": {
          "const": ["result_unresolved", "engine_transient_error"]
        },
        "empty_result_policy": {"enum": ["stop", "crosscheck-only"]},
        "resolution_source": {
          "enum": ["default_equivalent", "explicit", "domain_registered"]
        },
        "equivalence_group": {"type": ["string", "null"]},
        "registry_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/attempt"}
    },
    "final": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "ok",
        "selected_attempt",
        "fallback_trigger",
        "eligibility_reason",
        "alternate_result_adopted",
        "cross_engine_consistency"
      ],
      "properties": {
        "status": {
          "enum": [
            "primary_success",
            "primary_empty_verified",
            "primary_failed_not_eligible",
            "fallback_success",
            "fallback_failed",
            "fallback_not_started",
            "crosscheck_empty_consistent",
            "cross_engine_data_divergence",
            "crosscheck_inconclusive"
          ]
        },
        "ok": {"type": "boolean"},
        "selected_attempt": {"type": ["integer", "null"], "minimum": 1, "maximum": 2},
        "fallback_trigger": {
          "enum": ["result_unresolved", "engine_transient_error", "success_empty_crosscheck", null]
        },
        "eligibility_reason": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "alternate_result_adopted": {"type": "boolean"},
        "cross_engine_consistency": {
          "enum": ["not_checked", "consistent_empty", "divergent", "inconclusive"]
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "engine": {"enum": ["presto", "presto-lakehouse", "doris-presto"]},
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_no",
        "role",
        "engine",
        "sql_sha256",
        "query_id",
        "status",
        "ok",
        "result_state",
        "error_category",
        "transient_error_code",
        "elapsed_seconds",
        "result_artifact",
        "query_trace",
        "download"
      ],
      "properties": {
        "attempt_no": {"type": "integer", "minimum": 1, "maximum": 2},
        "role": {"enum": ["primary", "fallback", "crosscheck"]},
        "engine": {"$ref": "#/$defs/engine"},
        "sql_sha256": {"$ref": "#/$defs/sha256"},
        "query_id": {"type": ["string", "null"]},
        "status": {"type": "string"},
        "ok": {"type": "boolean"},
        "result_state": {
          "enum": [
            "success_with_rows",
            "success_ui_missing_recovered",
            "success_empty_verified",
            "success_with_rows_ui",
            "result_unresolved",
            null
          ]
        },
        "error_category": {"type": ["string", "null"]},
        "transient_error_code": {"type": ["string", "null"]},
        "elapsed_seconds": {"type": ["number", "null"], "minimum": 0},
        "result_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "artifact_id", "artifact_sha256", "validation_status"],
          "properties": {
            "path": {"type": "string"},
            "artifact_id": {"type": "string", "pattern": "^result_[0-9a-f]{32}$"},
            "artifact_sha256": {"$ref": "#/$defs/sha256"},
            "validation_status": {"enum": ["passed", "warning", "failed"]}
          }
        },
        "query_trace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "trace_id"],
          "properties": {
            "path": {"type": "string"},
            "trace_id": {"type": "string", "pattern": "^trace_[0-9a-f]{32}$"}
          }
        },
        "download": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "size_bytes"],
              "properties": {
                "path": {"type": "string"},
                "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
                "size_bytes": {"type": ["integer", "null"], "minimum": 0}
              }
            }
          ]
        }
      }
    }
  }
}
