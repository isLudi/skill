{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/text2sql/resolution_eval.schema.json",
  "title": "Domain semantic-resolution evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "cases"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "domain": {"enum": ["market_consultant", "qingcheng"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "query", "expected_ids", "expected_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "query": {"type": "string"},
          "expected_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "expected_status": {"enum": ["resolved", "ambiguous", "unknown"]},
          "category": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
