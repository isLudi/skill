{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/usql/query_engine_fallbacks.schema.json",
  "title": "USQL query engine fallback registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "supported_engines",
    "default_primary",
    "default_fallback_by_primary",
    "equivalence_groups",
    "explicit_only_engines",
    "domain_overrides"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "supported_engines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["presto", "presto-lakehouse", "doris-presto"]}
    },
    "default_primary": {"enum": ["presto", "presto-lakehouse", "doris-presto"]},
    "default_fallback_by_primary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "presto": {"enum": ["presto-lakehouse", "doris-presto"]},
        "presto-lakehouse": {"enum": ["presto", "doris-presto"]},
        "doris-presto": {"enum": ["presto", "presto-lakehouse"]}
      }
    },
    "equivalence_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "engines", "directory_equivalence", "confirmation", "confirmed_on"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "engines": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"enum": ["presto", "presto-lakehouse", "doris-presto"]}
          },
          "directory_equivalence": {"const": true},
          "confirmation": {"const": "user_confirmed"},
          "confirmed_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    },
    "explicit_only_engines": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["presto", "presto-lakehouse", "doris-presto"]}
    },
    "domain_overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "market_consultant": {"$ref": "#/$defs/domainOverride"},
        "qingcheng": {"$ref": "#/$defs/domainOverride"}
      }
    }
  },
  "$defs": {
    "domainOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "presto": {"enum": ["presto-lakehouse", "doris-presto"]},
        "presto-lakehouse": {"enum": ["presto", "doris-presto"]},
        "doris-presto": {"enum": ["presto", "presto-lakehouse"]}
      }
    }
  }
}
