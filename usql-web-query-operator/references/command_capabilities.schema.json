{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/usql/command_capabilities.schema.json",
  "title": "USQL operator command capability registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entrypoints"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entrypoint", "commands"],
        "properties": {
          "entrypoint": {"enum": ["usql_web_query.py", "read_dashboard.py"]},
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "effect", "authorization", "reference"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "effect": {
                  "enum": [
                    "local_read_only",
                    "remote_read_only",
                    "local_write_explicit",
                    "remote_write_explicit",
                    "temporary_remote_write",
                    "draft_write",
                    "publish",
                    "sandbox_write"
                  ]
                },
                "authorization": {
                  "enum": [
                    "none",
                    "explicit_command",
                    "explicit_flags",
                    "exact_plan_hash_and_confirmation",
                    "separate_publish_confirmation",
                    "sandbox_confirmation"
                  ]
                },
                "reference": {"type": "string", "pattern": "^[a-z0-9_]+\\.md$"}
              }
            }
          }
        }
      }
    }
  }
}
