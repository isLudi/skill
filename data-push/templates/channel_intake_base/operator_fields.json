[
  {"type":"text","name":"申请编号","description":"必填。稳定且唯一的需求编号；技术配置通过本编号对应的关联记录同步。建议格式：部门缩写-渠道标识。"},
  {"type":"select","name":"申请状态","multiple":false,"default_value":["草稿"],"options":[{"name":"草稿","hue":"Gray"},{"name":"待补充","hue":"Orange"},{"name":"待技术评审","hue":"Blue"},{"name":"待预览","hue":"Wathet"},{"name":"待试发","hue":"Purple"},{"name":"待上线","hue":"Carmine"},{"name":"已上线","hue":"Green"},{"name":"已暂停","hue":"Red"}]},
  {"type":"select","name":"申请部门","multiple":false,"options":[{"name":"市场顾问部","hue":"Blue"},{"name":"青橙项目部","hue":"Green"},{"name":"其他","hue":"Gray"}],"description":"必填。决定业务口径、配置目录和脚本归属，禁止跨部门复用口径。"},
  {"type":"user","name":"申请人","multiple":false,"description":"必填。实际提交需求的运营同学。"},
  {"type":"text","name":"业务负责人","description":"必填。负责确认口径、预览和上线效果的业务人员。"},
  {"type":"text","name":"需求背景","description":"说明为什么推送、供谁使用、希望解决什么问题。"},
  {"type":"text","name":"渠道标准名称","description":"必填。推送标题与管理台账中的统一名称，例如“朱博士”。"},
  {"type":"text","name":"原始渠道示例","description":"必填。列出原始数据里可能出现的渠道名称；多个值用中文分号分隔。"},
  {"type":"select","name":"渠道匹配方式","multiple":false,"options":[{"name":"精确匹配","hue":"Blue"},{"name":"名称包含","hue":"Green"},{"name":"多个精确值","hue":"Wathet"},{"name":"多个关键词同时包含","hue":"Purple"},{"name":"其他待评审","hue":"Orange"}]},
  {"type":"text","name":"匹配关键词或规范值","description":"必填。填写精确值或包含关键词；多个值请注明 AND/OR。"},
  {"type":"text","name":"排除关键词","description":"不参与计算的渠道关键词；没有则留空。"},
  {"type":"text","name":"数据源链接","style":{"type":"url"},"description":"必填。用于推送计算的数据源链接。"},
  {"type":"text","name":"原始表名称","description":"必填。原始明细表名称。"},
  {"type":"text","name":"原始表链接","style":{"type":"url"},"description":"尽量填写直接指向原始表或视图的链接。"},
  {"type":"text","name":"数据刷新频率","description":"例如每4小时、每日11点；补充最晚更新时间。"},
  {"type":"group_chat","name":"目标群","multiple":false,"description":"必填。直接选择接收推送的飞书群；正式脚本会解析并固定群ID。"},
  {"type":"text","name":"目标群名称（备用）","description":"无法直接选择群时填写完整群名；群名仅用于人工识别，不作为正式绑定。"},
  {"type":"select","name":"发送身份","multiple":false,"default_value":["管家机器人"],"options":[{"name":"管家机器人","hue":"Blue"},{"name":"指定机器人","hue":"Purple"},{"name":"用户身份","hue":"Orange"},{"name":"待确认","hue":"Gray"}]},
  {"type":"select","name":"期次规则","multiple":false,"options":[{"name":"自然周周五期次","hue":"Blue"},{"name":"自然日日期","hue":"Green"},{"name":"自然月","hue":"Wathet"},{"name":"手工指定","hue":"Orange"},{"name":"其他待评审","hue":"Gray"}]},
  {"type":"select","name":"过程数据星期","multiple":true,"options":[{"name":"周一"},{"name":"周二"},{"name":"周三"},{"name":"周四"},{"name":"周五"},{"name":"周六"},{"name":"周日"}]},
  {"type":"select","name":"转化数据星期","multiple":true,"options":[{"name":"周一"},{"name":"周二"},{"name":"周三"},{"name":"周四"},{"name":"周五"},{"name":"周六"},{"name":"周日"}]},
  {"type":"datetime","name":"期望首次上线日期","style":{"format":"yyyy-MM-dd"}},
  {"type":"text","name":"期望推送时段","description":"必填。按北京时间填写，例如13:00、17:00、21:00；技术侧会按全局错峰分配实际分钟。"},
  {"type":"select","name":"时区","multiple":false,"default_value":["Asia/Shanghai"],"options":[{"name":"Asia/Shanghai","hue":"Blue"},{"name":"其他待评审","hue":"Gray"}]},
  {"type":"select","name":"数据维度","multiple":true,"options":[{"name":"期次"},{"name":"渠道"},{"name":"年级"},{"name":"负责人"},{"name":"主管"},{"name":"顾问"},{"name":"学科"},{"name":"城市"},{"name":"其他"}],"description":"必填。勾选图片和提醒计算实际使用的粒度。"},
  {"type":"select","name":"年级范围","multiple":true,"options":[{"name":"幼儿园"},{"name":"一年级"},{"name":"二年级"},{"name":"三年级"},{"name":"四年级"},{"name":"五年级"},{"name":"六年级"},{"name":"初一"},{"name":"初二"},{"name":"初三"},{"name":"高一"},{"name":"高二"},{"name":"高三"},{"name":"不限"}]},
  {"type":"text","name":"其他范围或排除规则","description":"例如排除初二、只保留数学、只看指定城市。"},
  {"type":"text","name":"展示门槛指标","description":"例如退后线索；必须说明门槛应用到哪个聚合维度。"},
  {"type":"select","name":"门槛运算符","multiple":false,"options":[{"name":">="},{"name":">"},{"name":"="},{"name":"<="},{"name":"<"}]},
  {"type":"number","name":"门槛值","style":{"type":"plain","precision":2,"percentage":false,"thousands_separator":false}},
  {"type":"select","name":"过程指标（逐项勾选）","multiple":true,"options":[{"name":"退前线索"},{"name":"退后线索"},{"name":"线索留存率"},{"name":"总通时(min)"},{"name":"首call"},{"name":"首call率"},{"name":"48h外呼"},{"name":"外呼频次"},{"name":"5min"},{"name":"好友率"},{"name":"APP登陆率"},{"name":"深沟率"},{"name":"双沟率"},{"name":"实际进量"},{"name":"预估量级"},{"name":"量级完成度"},{"name":"接量顾问数"},{"name":"人均带班"},{"name":"异常流量占比"},{"name":"其他（在下方补充）"}],"description":"逐项勾选过程播报要展示的业务指标；不要填写字段名、SQL或计算公式。"},
  {"type":"text","name":"其他过程指标（每行一项）","description":"仅在上方没有所需指标时填写。每行一个：指标名称｜业务含义。"},
  {"type":"text","name":"过程指标展示顺序（选填）","description":"仅当顺序有要求时填写，按从左到右列出指标名称；技术人员负责匹配字段。"},
  {"type":"select","name":"转化指标（逐项勾选）","multiple":true,"options":[{"name":"退后线索"},{"name":"5min"},{"name":"双沟率"},{"name":"首节到课率"},{"name":"当期单效"},{"name":"单效（当期）"},{"name":"截面单效"},{"name":"综合单效"},{"name":"人均报科"},{"name":"人头转化"},{"name":"订单转化"},{"name":"净收款"},{"name":"退费率"},{"name":"单效"},{"name":"其他（在下方补充）"}],"description":"逐项勾选转化播报要展示的业务指标；两个部门可以选择完全不同的指标。"},
  {"type":"text","name":"其他转化指标（每行一项）","description":"仅在上方没有所需指标时填写。每行一个：指标名称｜业务含义。"},
  {"type":"text","name":"转化指标展示顺序（选填）","description":"仅当顺序有要求时填写，按从左到右列出指标名称；技术人员负责匹配字段。"},
  {"type":"text","name":"指标口径补充（每行一项）","description":"对容易误解或部门专属的指标逐行说明：指标名称｜业务含义｜希望观察高或低。技术公式由技术人员补全。"},
  {"type":"select","name":"过程重点提醒指标","multiple":false,"options":[{"name":"5min"},{"name":"线索留存率"},{"name":"量级完成度"},{"name":"异常流量占比"},{"name":"其他（在下方补充）"},{"name":"不需要提醒"}],"description":"选择过程播报中需要重点提醒的一个业务指标。"},
  {"type":"select","name":"转化重点提醒指标","multiple":false,"options":[{"name":"单效"},{"name":"截面单效"},{"name":"综合单效"},{"name":"首节到课率"},{"name":"人头转化"},{"name":"订单转化"},{"name":"净收款"},{"name":"退费率"},{"name":"其他（在下方补充）"},{"name":"不需要提醒"}],"description":"选择转化播报中需要重点提醒的一个业务指标。"},
  {"type":"text","name":"过程数据排序规则","description":"按优先级写明指标、方向及并列时的稳定排序。"},
  {"type":"text","name":"转化数据排序规则","description":"按优先级写明指标、方向及并列时的稳定排序。"},
  {"type":"checkbox","name":"展示总计行"},
  {"type":"text","name":"图片分组与排版","description":"例如按渠道和年级分块，每行负责人-主管-顾问，过程图在前。"},
  {"type":"text","name":"颜色或样式参考","description":"填写参考渠道、截图或明确的颜色规则。"},
  {"type":"text","name":"过程提醒指标","description":"技术回填项：过程重点提醒指标对应的正式计算公式，运营无需填写。"},
  {"type":"text","name":"转化提醒指标","description":"技术回填项：转化重点提醒指标对应的正式计算公式，运营无需填写。"},
  {"type":"select","name":"提醒对象","multiple":false,"options":[{"name":"负责人"},{"name":"主管"},{"name":"顾问"},{"name":"不提醒"},{"name":"其他待评审"}]},
  {"type":"select","name":"播报层级","multiple":false,"options":[{"name":"主管"},{"name":"顾问"},{"name":"学部"},{"name":"负责人"}],"description":"当前申请的播报层级；按对应部门与渠道规则填写，不从群名或数据维度推断。"},
  {"type":"select","name":"过程文字提醒名次","multiple":false,"options":[{"name":"最后1名"},{"name":"不提醒"},{"name":"不适用"},{"name":"最低值"},{"name":"底部10%（每年级至少1名）"}],"description":"过程报告的文字提醒名次；按部门与渠道规则填写，无该类报告选不适用，并列处理另按适用规则填写。"},
  {"type":"select","name":"转化文字提醒名次","multiple":false,"options":[{"name":"第1名"},{"name":"前3名"},{"name":"不提醒"},{"name":"不适用"},{"name":"最低值"},{"name":"底部10%（每年级至少1名）"}],"description":"转化报告的文字提醒名次；按部门与渠道规则填写，无该类报告选不适用，并列处理另按适用规则填写。"},
  {"type":"select","name":"过程指标提醒方向","multiple":false,"options":[{"name":"最低"},{"name":"最高"},{"name":"异常命中"},{"name":"固定人员"}]},
  {"type":"select","name":"转化指标提醒方向","multiple":false,"options":[{"name":"最低"},{"name":"最高"},{"name":"固定人员"}]},
  {"type":"select","name":"并列处理","multiple":false,"options":[{"name":"全部提醒"},{"name":"按排序取首位"},{"name":"不提醒"},{"name":"按排序取前三位"}]},
  {"type":"text","name":"@规则说明","description":"说明是否必须在群、重名或数字后缀如何处理、未解析时是否阻断。"},
  {"type":"text","name":"过程消息文案模板","description":"保留变量占位符，例如{期次}、{渠道}、{年级}、{提醒对象}。"},
  {"type":"text","name":"转化消息文案模板","description":"保留变量占位符，例如{期次}、{渠道}、{年级}、{提醒对象}。"},
  {"type":"select","name":"无符合条件数据时","multiple":false,"options":[{"name":"跳过不发送"},{"name":"发送空报说明"},{"name":"报错并阻断"}]},
  {"type":"text","name":"异常与重试要求","description":"例如数据未刷新时每2分钟重试至:50，不补发历史批次。"},
